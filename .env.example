# ==============================================================================
# SCHOLARBOT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions for running ScholarBot:
#
# Option A - Local Bureau Mode (Fastest local test):
#   python run_all.py
#
# Option B - Multi-Process Mode (4 separate terminals):
#   Terminal 1: python agents/matcher.py     (Runs on port 8002)
#   Terminal 2: python agents/auditor.py     (Runs on port 8003)
#   Terminal 3: python agents/tracker.py     (Runs on port 8004)
#   Terminal 4: python agents/coordinator.py (Runs on port 8001)
#
# Option C - Agentverse Live Mailbox Mode:
#   1. Create an agent on https://agentverse.ai
#   2. Navigate to 'Deploy' -> 'Mailbox' -> Copy your Mailbox API Key
#   3. Set AGENTVERSE_MAILBOX_KEY below
#   4. Start the coordinator: python agents/coordinator.py
# ==============================================================================

# 1. ASI1 LLM API (OpenAI-compatible)
# Sign up at https://asi1.ai or Fetch.ai Innovation Lab
ASI1_API_KEY=
ASI1_BASE_URL=https://api.asi1.ai/v1
ASI1_MODEL=asi1

# 2. AGENTVERSE & MAILBOX CONFIGURATION
# Obtain Mailbox key from https://agentverse.ai (My Agents -> Create Agent -> Mailbox)
AGENTVERSE_MAILBOX_KEY=

# 3. AGENT SEEDS (Generate your own unique secure seeds before running)
# Example: python -c "import secrets; print(secrets.token_hex(16))"
COORDINATOR_SEED=
MATCHER_SEED=
AUDITOR_SEED=
TRACKER_SEED=

# 4. AGENT PORTS
PORT=8001
COORDINATOR_PORT=8001
MATCHER_PORT=8002
AUDITOR_PORT=8003
TRACKER_PORT=8004

# 5. SPECIALIST AGENT TARGET ADDRESSES
# If running across distinct machines or separate Agentverse hosted instances, paste the
# addresses printed by `python scripts/print_addresses.py` here:
SCHEME_AGENT_ADDRESS=
DOC_AGENT_ADDRESS=
TRACKER_AGENT_ADDRESS=

# 6. ASSET BASE URL (For card images in ASI:One)
ASSET_BASE_URL=https://raw.githubusercontent.com/fetchai/scholarbot/master/assets

# 7. FETCH.AI PAYMENT PROTOCOL
# Set to 'true' for testnet / demo validation
PAYMENT_DEMO_MODE=true
